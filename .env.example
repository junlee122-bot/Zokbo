# ---------------------------------------------------------------------------
# Zokbo (Notion 백엔드) 환경변수
# 이 파일을 복사해 `.env.local` 로 만든 뒤 값을 채우세요.
# ---------------------------------------------------------------------------

# Notion 내부 통합(integration) 토큰. https://www.notion.so/my-integrations
# 서버 전용 — 절대 클라이언트로 노출되지 않습니다(NEXT_PUBLIC_ 아님).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zokbo Files 데이터베이스 ID.
#   `npm run setup-notion` 으로 DB를 자동 생성하면 출력됩니다.
NOTION_FILES_DB_ID=

# setup-notion 스크립트로 DB를 만들 때만 필요한 "부모 페이지" ID.
# (DB 생성 후에는 안 써도 됩니다)
NOTION_PARENT_PAGE_ID=

# 앱 접속 비밀번호(개인용 단일 로그인). 원하는 값으로 바꾸세요.
APP_PASSWORD=change-this-password

# 세션 서명용 비밀키. 길고 무작위한 값으로.
#   예) node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# 파일 소유자로 기록될 이름(선택, 기본 "나"). 나중에 공유 시 구분용.
OWNER_NAME=나
