# ---------------------------------------------------------------------------
# Supabase 연결 정보 (Supabase 대시보드 > Project Settings > API 에서 복사)
# 이 파일을 복사해 `.env.local` 로 만든 뒤 실제 값으로 채우세요.
# ---------------------------------------------------------------------------

# 브라우저에 노출되어도 안전한 공개 키 (anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 서버 전용 비밀 키 — 절대 브라우저/클라이언트로 노출 금지.
# 관리자 초대(이메일 발송) 같은 admin API 호출에만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 앱의 공개 URL (초대 메일의 리다이렉트 등에 사용). 로컬은 아래 값 그대로.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
